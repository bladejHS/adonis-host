    "/reservations": {
      "get": {
        "description": "Filtre: interval (rezervări care se suprapun cu el), stare, canal.",
        "operationId": "ReservationsController_list",
        "parameters": [
          {
            "name": "source",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "pending",
                "confirmed",
                "checked_in",
                "checked_out",
                "cancelled",
                "no_show"
              ],
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "schema": {
              "example": "2026-10-31"
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "schema": {
              "example": "2026-10-01"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Listă rezervări",
        "tags": [
          "Rezervări"
        ]
      },
      "post": {
        "description": "Prețul se calculează pe sezon dacă nu se trimite totalAmount. Refuză camerele ocupate.",
        "operationId": "ReservationsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "roomId": {
                    "type": "string"
                  },
                  "checkIn": {
                    "type": "string",
                    "format": "date",
                    "example": "2027-07-12"
                  },
                  "checkOut": {
                    "type": "string",
                    "format": "date",
                    "example": "2027-07-17"
                  },
                  "adults": {
                    "type": "integer",
                    "example": 2
                  },
                  "children": {
                    "type": "integer"
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "direct",
                      "phone",
                      "booking",
                      "airbnb",
                      "other"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "confirmed"
                    ]
                  },
                  "totalAmount": {
                    "type": "number"
                  },
                  "advance": {
                    "type": "number"
                  },
                  "notes": {
                    "type": "string"
                  },
                  "guest": {
                    "type": "object",
                    "properties": {
                      "firstName": {
                        "type": "string"
                      },
                      "lastName": {
                        "type": "string"
                      },
                      "phone": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string"
                      },
                      "city": {
                        "type": "string"
                      }
                    }
                  }
                },
                "required": [
                  "roomId",
                  "checkIn",
                  "checkOut",
                  "adults",
                  "guest"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Rezervare nouă",
        "tags": [
          "Rezervări"
        ]
      }
    },
