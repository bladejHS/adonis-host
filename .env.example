# ─── Adonis Host — variabile de mediu ───
# Copiați în .env (docker compose) sau în setările Vercel/Railway. Nu puneți niciodată cheile în git.

# Bază de date. Local: SQLite (cale absolută). Producție: PostgreSQL.
DATABASE_URL="file:/cale/absoluta/catre/adonis/packages/database/prisma/dev.db"
# DATABASE_URL="postgresql://utilizator:parola@host:5432/adonis?sslmode=require"

# Semnarea sesiunilor personalului — minim 32 de caractere aleatorii (ex: openssl rand -base64 48)
AUTH_SECRET=""

# Adresele publice ale aplicațiilor
NEXT_PUBLIC_BASE_URL="http://localhost:3000"   # admin (apare în linkurile iCal exportate)
GUEST_BASE_URL="http://localhost:3001"         # pagina oaspeților (check-in, oferte)
API_BASE_URL="http://localhost:4000"           # API (webhook-uri plăți, aplicația mobilă)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Sincronizare programată: cu Redis rulează prin BullMQ; fără, prin temporizator intern
REDIS_URL=""

# Fișiere (acte, semnături, poze daune). Local: director. Producție: Cloudflare R2.
STORAGE_DIR="./storage"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Plăți (fără chei: pagina demo, nu se încasează bani)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NETOPIA_API_KEY=""
NETOPIA_POS_SIGNATURE=""
NETOPIA_SANDBOX="true"

# Facturare și e-Factura prin SmartBill
SMARTBILL_EMAIL=""
SMARTBILL_TOKEN=""
SMARTBILL_CIF=""
SMARTBILL_SERIES="ADN"

# WhatsApp Business Cloud API (fără chei: se deschide WhatsApp cu mesajul completat)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# Notificări push către aplicația mobilă (opțional, pentru proiecte Expo cu acces securizat)
EXPO_ACCESS_TOKEN=""

# Booking.com XML — rămâne false până la aprobarea ca partener de conectivitate
BOOKING_XML_ENABLED="false"
