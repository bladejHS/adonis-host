    "react-router-dom": "6.28.0",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.6",
    "typescript": "5.6.3",
    "vite": "5.4.11"
