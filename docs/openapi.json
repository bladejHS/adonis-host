              "schema": {
                "type": "object",
                "required": [
                  "firstName",
                  "lastName",
                  "country",
                  "idDocType",
                  "idDocNumber",
                  "idImage",
                  "signature",
                  "consentGdpr"
                ],
                "properties": {
                  "firstName": {
                    "type": "string"
                  },
                  "lastName": {
                    "type": "string"
                  },
                  "country": {
                    "type": "string",
                    "example": "RO"
                  },
                  "idDocType": {
                    "type": "string",
                    "enum": [
                      "CI",
                      "pasaport"
                    ]
                  },
                  "idDocNumber": {
                    "type": "string",
                    "example": "CT123456"
                  },
                  "cnp": {
                    "type": "string"
                  },
                  "idImage": {
                    "type": "string",
                    "description": "data URL JPEG/PNG"
                  },
                  "signature": {
                    "type": "string",
                    "description": "data URL PNG"
                  },
                  "consentGdpr": {
                    "type": "boolean"
                  },
                  "consentMarketing": {
                    "type": "boolean"
                  },
                  "consentWhatsapp": {
                    "type": "boolean"
