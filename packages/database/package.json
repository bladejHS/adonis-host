{
  "name": "@adonis/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "push": "prisma db push --skip-generate",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "generate:pg": "node ../../scripts/prisma-provider.mjs postgresql && prisma generate",
    "migrate:deploy": "node ../../scripts/prisma-provider.mjs postgresql && prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "prisma": "5.22.0",
    "tsx": "4.20.6",
    "typescript": "5.6.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./enums": "./src/enums.ts",
    "./pricing": "./src/pricing.ts"
  }
}
