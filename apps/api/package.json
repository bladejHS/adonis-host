{
  "name": "@adonis/api",
  "version": "0.1.0",
  "private": true,
  "description": "API Adonis Host (NestJS): aplicația mobilă, check-in, webhook-uri plăți, sincronizare programată",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "openapi": "tsx --env-file-if-exists=.env scripts/openapi.ts",
    "typecheck": "tsc --noEmit",
    "alerts": "tsx --env-file-if-exists=.env scripts/refresh-alerts.ts"
  },
  "dependencies": {
    "@adonis/core": "workspace:*",
    "@adonis/database": "workspace:*",
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/swagger": "8.1.1",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "tsx": "4.20.6",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.17.6",
    "typescript": "5.6.3"
  }
}
